// Negotiate an authorized direct carrier before constructing the native RDP socket. No TURN.
(() => {
  const protocol = 'cloudssh-rdp-peer-v2', frame = 16 * 1024, limit = 1024 * 1024;
  window.prepareCloudSshPeerCarrier = (address, api, abi, ticket, signal, pathSample) => {
    if (signal.aborted || typeof RTCPeerConnection !== 'function') return Promise.reject(new Error('peer_unavailable'));
    const pc = new RTCPeerConnection({ iceServers: [{ urls: 'stun:stun.cloudflare.com:3478' }] });
    let ws;
    try { ws = new WebSocket(address, protocol); } catch { pc.close(); return Promise.reject(new Error('peer_failed')); }
    const abort = new AbortController();
    let channel, lease, stage = 'ticket', stopped = false, activated = false, busy = false, renewal, iceTimer, lastActivity = -Infinity, didReport = false;
    let complete, reject;
    const prepared = new Promise((accept, fail) => { complete = accept; reject = fail; });
    const timer = setTimeout(() => end('peer_timeout'), 14_000);
    const cancel = () => end('peer_ended');
    signal.addEventListener('abort', cancel, { once: true });
    const carrier = { protocol: 'cloudssh-rdp-v1', send, close: cancel, activate() {
      queueMicrotask(() => {
        if (activated) return;
        activated = true;
        if (stopped || stage !== 'live') return carrier.onclose?.({ reason: 'peer_ended' });
        forward(JSON.stringify({ type: 'ready', lease, desktopReport: true }));
      });
    } };
    function end(reason) {
      if (stopped) return;
      stopped = true; ticket = undefined;
      signal.removeEventListener('abort', cancel);
      clearTimeout(timer); clearTimeout(iceTimer); clearInterval(renewal); abort.abort();
      try { channel?.close(); } catch {} try { pc.close(); } catch {} try { ws.close(); } catch {}
      reject(new Error(reason));
      if (activated) carrier.onclose?.({ reason });
    }
    const forward = data => { if (!stopped) carrier.onmessage?.({ data }); };
    const rtcSend = data => {
      if (stage !== 'live' || channel.readyState !== 'open' || channel.bufferedAmount > limit + frame) return end('peer_failed');
      channel.send(data);
    };
    function send(data) {
      if (stopped) return;
      try {
        if (!activated || stage !== 'live') return end('peer_failed');
        if (typeof data !== 'string') {
          if (!ArrayBuffer.isView(data) || !data.byteLength || data.byteLength > frame) return end('peer_failed');
          return rtcSend(data);
        }
        const msg = JSON.parse(data);
        if (msg.type === 'ping') { void sampleSelectedPath().catch(() => {}); return rtcSend(data); }
        if (msg.type === 'ack') return rtcSend(data);
        if (msg.type === 'cert_wait' || msg.type === 'cert_done') return ws.send(data);
        if (msg.type === 'desktop_ready' && !didReport) { didReport = true; return ws.send(data); }
        if (msg.type === 'activity') {
          if (performance.now() - lastActivity >= 5000) { lastActivity = performance.now(); ws.send(data); }
          return;
        }
        end('peer_failed');
      } catch { end('peer_failed'); }
    }
    async function renew() {
      if (stopped || busy) return;
      busy = true;
      try {
        const res = await fetch(api + '/peer-renew', { method: 'POST', credentials: 'same-origin', redirect: 'error',
          headers: { 'Content-Type': 'application/json', 'X-CloudSSH-RDP-Client': abi }, body: JSON.stringify({ lease }),
          signal: AbortSignal.any([abort.signal, AbortSignal.timeout(6000)]) });
        if (!res.ok) end('lease_ended');
      } catch { end('lease_ended'); } finally { busy = false; }
    }
    const localType = x => ['host', 'srflx', 'prflx'].includes(x);
    async function sampleSelectedPath() {
      const pair = pc.sctp?.transport?.iceTransport?.getSelectedCandidatePair?.();
      let local = pair?.local?.type, remote = pair?.remote?.type;
      if (!local || !remote) {
        const stats = await pc.getStats();
        for (const report of stats.values()) if (report.type === 'transport' && report.selectedCandidatePairId) {
          const chosen = stats.get(report.selectedCandidatePairId);
          local = stats.get(chosen?.localCandidateId)?.candidateType;
          remote = stats.get(chosen?.remoteCandidateId)?.candidateType;
          break;
        }
      }
      if (stopped) return;
      if (local === 'relay' || remote === 'relay') return end('peer_failed');
      if (localType(local) && localType(remote)) pathSample(local, remote);
    }
    async function offer() {
      channel = pc.createDataChannel(protocol, { ordered: true }); channel.binaryType = 'arraybuffer';
      channel.onclose = channel.onerror = () => end('peer_failed');
      channel.onmessage = ({ data }) => {
        if (stopped) return;
        try {
          if (typeof data !== 'string') {
            if (!activated || stage !== 'live' || !(data instanceof ArrayBuffer) || !data.byteLength || data.byteLength > frame) return end('peer_failed');
            return forward(data);
          }
          if (data.length > 192) return end('peer_failed');
          const m = JSON.parse(data);
          if (stage === 'opening' && m.type === 'direct_ready' && localType(m.local) && localType(m.remote)) {
            // Pion verified the SELECTED ICE path and local TCP. No RDP bytes can be sent until activation.
            stage = 'live'; clearTimeout(timer); pathSample(m.remote, m.local);
            complete(carrier); return;
          }
          if (activated && stage === 'live' && (m.type === 'ack' || m.type === 'pong')) return forward(data);
          end('peer_failed');
        } catch { end('peer_failed'); }
      };
      await pc.setLocalDescription(await pc.createOffer());
      if (pc.iceGatheringState !== 'complete' && !stopped) await new Promise(resolve => {
        const done = () => { clearTimeout(iceTimer); pc.removeEventListener('icegatheringstatechange', change); abort.signal.removeEventListener('abort', done); resolve(); };
        const change = () => { if (pc.iceGatheringState === 'complete') done(); };
        pc.addEventListener('icegatheringstatechange', change); abort.signal.addEventListener('abort', done, { once: true }); iceTimer = setTimeout(done, 3500);
      });
      if (stopped) return;
      const sdp = pc.localDescription?.sdp;
      if (!sdp || sdp.length > 12_288) return end('peer_failed');
      stage = 'answer'; ws.send(JSON.stringify({ type: 'offer', sdp }));
    }
    ws.onopen = () => {
      if (ws.protocol !== protocol || stage !== 'ticket') return end('peer_failed');
      stage = 'pair';
      try { ws.send(JSON.stringify({ type: 'ticket', ticket })); } catch { end('peer_failed'); }
      ticket = undefined;
    };
    ws.onclose = event => end(event.reason || 'peer_failed'); ws.onerror = () => end('peer_failed');
    pc.onconnectionstatechange = () => { if (['failed', 'disconnected'].includes(pc.connectionState)) end('peer_failed'); };
    ws.onmessage = ({ data }) => {
      void (async () => {
        if (stopped) return;
        if (typeof data !== 'string' || data.length > 14_000) return end('peer_failed');
        const m = JSON.parse(data);
        if (m.type === 'paired' && stage === 'pair' && /^[a-f0-9-]{36}$/.test(m.lease)) {
          stage = 'gather'; lease = m.lease; renewal = setInterval(renew, 12_000); return offer();
        }
        if (m.type === 'answer' && stage === 'answer' && typeof m.sdp === 'string' && m.sdp.length <= 12_288) {
          stage = 'opening'; return pc.setRemoteDescription({ type: 'answer', sdp: m.sdp });
        }
        if (m.type === 'desktop_recorded' && stage === 'live' && didReport) return forward(data);
        end('peer_failed');
      })().catch(() => end('peer_failed'));
    };
    return prepared;
  };
})();
