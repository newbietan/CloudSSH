// Fixed enum names from the bundled FreeRDP connection.c and nla.c. Never display an
// unknown value or guess a protocol state from traffic, Windows events or log text.
// Ordinals of CONNECTION_STATE (types.h) and NLA_STATE (nla.h), in wire-independent native order.
const connectionById = `INITIAL NEGO NLA AAD MCS_CREATE_REQUEST MCS_CREATE_RESPONSE MCS_ERECT_DOMAIN
  MCS_ATTACH_USER MCS_ATTACH_USER_CONFIRM MCS_CHANNEL_JOIN_REQUEST MCS_CHANNEL_JOIN_RESPONSE
  RDP_SECURITY_COMMENCEMENT SECURE_SETTINGS_EXCHANGE CONNECT_TIME_AUTO_DETECT_REQUEST
  CONNECT_TIME_AUTO_DETECT_RESPONSE LICENSING MULTITRANSPORT_BOOTSTRAPPING_REQUEST MULTITRANSPORT_BOOTSTRAPPING_RESPONSE
  CAPABILITIES_EXCHANGE_DEMAND_ACTIVE CAPABILITIES_EXCHANGE_MONITOR_LAYOUT CAPABILITIES_EXCHANGE_CONFIRM_ACTIVE
  FINALIZATION_SYNC FINALIZATION_COOPERATE FINALIZATION_REQUEST_CONTROL FINALIZATION_PERSISTENT_KEY_LIST
  FINALIZATION_FONT_LIST FINALIZATION_CLIENT_SYNC FINALIZATION_CLIENT_COOPERATE FINALIZATION_CLIENT_GRANTED_CONTROL
  FINALIZATION_CLIENT_FONT_MAP ACTIVE`.split(/\s+/);
const nlaById = `INITIAL NEGO_TOKEN PUB_KEY_AUTH EARLY_USER_AUTH AUTH_INFO POST_NEGO FINAL`.split(/\s+/);
const connectionStates = new Set(connectionById.map(name => 'CONNECTION_STATE_' + name));
const nlaStates = new Set(nlaById.map(name => 'NLA_STATE_' + name));
function lastNativeState() {
  // One atomic load from static WASM memory; no RDP object, polling or callback into a pthread.
  let word;
  try { word = window.Module?._cloudssh_read_rdp_state?.(); } catch { return; }
  if (!Number.isInteger(word) || word < 256 || word > 0xffff) return;
  const phase = connectionById[word >>> 8], sub = word & 255;
  if (!phase || (phase !== 'NLA' && sub)) return;
  const nla = sub && nlaById[sub - 1];
  return nla ? phase + ' / ' + nla : phase;
}
