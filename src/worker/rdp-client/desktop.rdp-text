const authErrors = /\bERRCONNECT_(?:AUTHENTICATION_FAILED|LOGON_FAILURE|WRONG_PASSWORD|ACCOUNT_DISABLED|ACCOUNT_EXPIRED|ACCOUNT_LOCKED_OUT|ACCOUNT_RESTRICTION|PASSWORD_CERTAINLY_EXPIRED|PASSWORD_EXPIRED|PASSWORD_MUST_CHANGE|LOGON_TYPE_NOT_GRANTED|NO_OR_MISSING_CREDENTIALS|ACCESS_DENIED|INSUFFICIENT_PRIVILEGES|KDC_UNREACHABLE)\b/;
const securityErrors = /\bERRCONNECT_(?:SECURITY_NEGO_CONNECT_FAILED|TLS_CONNECT_FAILED|HYBRID_REQUIRED_BY_SERVER)\b/;
const transportErrors = /\bERRCONNECT_CONNECT_TRANSPORT_FAILED\b/;
const ntlmErrors = /\b(?:ERRCONNECT|STATUS)_NTLM_BLOCKED\b/;
const graphicsErrors = /\b(?:ERRINFO_GRAPHICS_(?:MODE_NOT_SUPPORTED|SUBSYSTEM_(?:RESET_)?FAILED)|H264 decompress failed|rdpgfx_decode_AVC(?:420|444) failed)\b/;
// Keep both ABIs aligned with src/rdp-schema.ts. Existing trust and peer renewal still use v5.
const clientRevision = '5';
const connectRevision = '6';
// FreeRDP 3.33.1 uses TcpAckTimeout (default 9000 ms) for the whole event-driven
