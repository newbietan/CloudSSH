  authentication_required: ['Your sign-in has expired. Return and sign in again.', '登录已失效，请返回并重新登录。', '登入已失效，請返回並重新登入。'],
  ticket_rejected: ['Connection ticket is no longer valid. Reopen the device for a new one.', '连接票据已失效，请从列表重新打开设备。', '連線票據已失效，請從清單重新開啟裝置。'],
  ticket_limit: ['Too many connection attempts. Wait a moment, then reopen the device.', '连接请求过多，请稍候再从列表打开设备。', '連線請求過多，請稍候再從清單開啟裝置。'],
  lease_ended: ['This desktop session is no longer valid. Return to the list and reopen the device.', '此桌面会话已失效，请返回列表重新打开设备。', '此桌面工作階段已失效，請返回清單重新開啟裝置。'],
  idle_timeout: ['Disconnected after inactivity. Reopen the device to continue.', '因长时间无操作已断开，可从列表重新连接。', '因長時間無操作已斷線，可從清單重新連線。'],
  cert_timeout: ['Certificate confirmation timed out. Reopen the device to try again.', '证书确认超时，请重新打开设备后重试。', '憑證確認逾時，請重新開啟裝置後重試。'],
  session_limit: ['The two-hour session limit was reached. Reopen the device to continue.', '已达到两小时会话上限，可从列表重新连接。', '已達兩小時工作階段上限，可從清單重新連線。'],
  upstream_unavailable: ['Could not reach Windows. Check the server address or tunnel and try again.', '无法连接 Windows，请检查服务器地址或隧道后重试。', '無法連線至 Windows，請檢查伺服器位址或隧道後重試。'],
  direct_dns_failed: ['Could not resolve the hostname. Check its public A or AAAA records and try again.', '无法解析域名，请检查公网 A 或 AAAA 记录后重试。', '無法解析網域，請檢查公網 A 或 AAAA 記錄後重試。'],
  direct_dns_blocked: ['This hostname resolved to a non-public or unsupported address. Use Cloudflare Tunnel for private targets.', '域名解析到了非公网或不支持的地址；内网目标请使用 Cloudflare Tunnel。', '網域解析到非公網或不支援的位址；內網目標請使用 Cloudflare Tunnel。'],
  slow_connection: ['Data transfer stalled. Check your network and reconnect.', '数据传输停滞，请检查网络后重新连接。', '資料傳輸停滯，請檢查網路後重新連線。'],
};
const trustText = {
  'en-US': ['First connection to Windows', 'Verify this certificate fingerprint through a trusted source before accepting. An unexpected fingerprint may mean you reached a different server.', 'Cancel', 'Trust and connect', 'Windows certificate changed', 'Connection blocked. The received fingerprint differs from the one you saved.', 'Previously saved fingerprint', 'Could not record certificate trust. Reconnect and try again.', 'Waiting for certificate confirmation.', 'Certificate was not accepted.'],
  'zh-CN': ['首次连接此 Windows 服务器', '请通过可信方式核对证书指纹再确认。意外的指纹可能表示你连接到了另一台服务器。', '取消', '信任并连接', 'Windows 证书已变化', '连接已阻止：收到的证书指纹与已保存的指纹不一致。', '已保存的指纹', '无法保存证书信任，请重新连接。', '等待确认 Windows 证书。', '未接受 Windows 证书。'],
  'zh-TW': ['首次連線至此 Windows 伺服器', '請透過可信方式核對憑證指紋再確認。意外的指紋可能表示你連線到了另一台伺服器。', '取消', '信任並連線', 'Windows 憑證已變更', '連線已阻擋：收到的憑證指紋與已儲存的指紋不一致。', '已儲存的指紋', '無法儲存憑證信任，請重新連線。', '等待確認 Windows 憑證。', '未接受 Windows 憑證。'],
};
// Match the workspace language, including an explicit ?lang override in the parent.
let requested = window.frameElement?.ownerDocument.documentElement.lang;
if (!requested || !Object.hasOwn(dictionary, requested)) {
  requested = navigator.language;
  try { requested = localStorage.getItem('cloudssh_locale') || requested; } catch { /* optional */ }
}
const locale = Object.hasOwn(dictionary, requested) ? requested : /^zh-(TW|HK|Hant)/i.test(requested) ? 'zh-TW' : /^zh/i.test(requested) ? 'zh-CN' : 'en-US';
document.documentElement.lang = locale;
const msg = dictionary[locale];
const failure = code => typeof code === 'string' && Object.hasOwn(failureText, code)
  ? failureText[code][locale === 'en-US' ? 0 : locale === 'zh-CN' ? 1 : 2] : undefined;
async function requestFailure(response) {
  if (response.status === 401) return failure('authentication_required');
  const data = await response.json().catch(() => null);
  return failure(data?.code) ?? msg[17];
}
const el = id => document.getElementById(id);
const tellWorkspace = (type, detail) => window.frameElement?.dispatchEvent(new CustomEvent('cloudssh-rdp-' + type, { detail }));
const status = el('status');
const show = i => {
  status.classList.toggle('desktop-ready', i === 15); // Announce readiness without taking a row from the desktop.
  status.textContent = msg[i];
};
const canvas = el('canvas');
const stage = el('stage');
// CSS pixels; SDL's external-canvas backend reports these to the negotiated DISP channel.
const viewportSize = () => {
  const w = Math.max(1, stage.clientWidth), h = Math.max(1, stage.clientHeight);
  const scale = Math.min(1, 3840 / w, 2160 / h);
  return [Math.max(200, Math.floor(w * scale / 2) * 2), Math.max(200, Math.floor(h * scale / 2) * 2)];
};
const deviceId = location.pathname.split('/')[2];
const api = '/api/rdp/profiles/' + deviceId;
const authErrors = /\bERRCONNECT_(?:AUTHENTICATION_FAILED|LOGON_FAILURE|WRONG_PASSWORD|ACCOUNT_DISABLED|ACCOUNT_EXPIRED|ACCOUNT_LOCKED_OUT|ACCOUNT_RESTRICTION|PASSWORD_CERTAINLY_EXPIRED|PASSWORD_EXPIRED|PASSWORD_MUST_CHANGE|LOGON_TYPE_NOT_GRANTED|NO_OR_MISSING_CREDENTIALS|NTLM_BLOCKED|ACCESS_DENIED|INSUFFICIENT_PRIVILEGES|KDC_UNREACHABLE)\b/;
const securityErrors = /\bERRCONNECT_(?:SECURITY_NEGO_CONNECT_FAILED|TLS_CONNECT_FAILED|HYBRID_REQUIRED_BY_SERVER)\b/;
const transportErrors = /\bERRCONNECT_CONNECT_TRANSPORT_FAILED\b/;
// Keep both ABIs aligned with src/rdp-schema.ts. Existing trust and peer renewal still use v5.
const clientRevision = '5';
const connectRevision = '6';
const trust = trustText[locale];
const certificate = el('certificate');
const acceptCertificate = el('certificate-accept');
const cancelCertificate = el('certificate-cancel');
const formatFingerprint = value => value.toUpperCase().match(/../g).join(':');
const base = '/rdp/assets/';
let socket;
let profile;
let terminate;
show(8);

function request(url, options) {
  return fetch(url, { credentials: 'same-origin', redirect: 'error', signal: AbortSignal.timeout(10000), ...options });
}

const loginCurve = { name: 'ECDH', namedCurve: 'P-256' };
const loginEncoder = new TextEncoder();
const loginBase64Url = raw => btoa(raw).replace(/=+$/, '').replace(/\+/g, '-').replace(/\//g, '_');
function decodeLoginPart(value, min, max = min) {
  if (typeof value !== 'string' || value.length < Math.ceil(min * 4 / 3) ||
      value.length > Math.ceil(max * 4 / 3) || !/^[A-Za-z0-9_-]+$/.test(value)) throw new Error('invalid envelope');
  const raw = atob(value.replace(/-/g, '+').replace(/_/g, '/'));
  if (raw.length < min || raw.length > max || loginBase64Url(raw) !== value) throw new Error('invalid envelope');
  return Uint8Array.from(raw, c => c.charCodeAt(0));
}

// Fetch's attempt deadline also bounds reading this body. Never accept legacy plaintext or unbounded JSON.
async function readConnectGrant(response, revision) {
  const bytes = new Uint8Array(12 * 1024);
  const reader = response.body?.getReader();
  if (!reader) throw new Error('missing envelope');
  let size = 0, value;
  try {
    for (;;) {
      const chunk = await reader.read();
      if (chunk.done) break;
      if (size + chunk.value.length > bytes.length) throw new Error('oversized envelope');
      bytes.set(chunk.value, size); size += chunk.value.length;
    }
    value = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(bytes.subarray(0, size)));
  } finally {
    bytes.fill(0);
    void reader.cancel().catch(() => {}); reader.releaseLock();
  }
  const box = value?.loginEnvelope;
  if (!value || Object.keys(value).length !== 3 || value.revision !== revision ||
      typeof value.ticket !== 'string' || !/^[a-f0-9]{64}$/.test(value.ticket) ||
      !box || Object.keys(box).length !== 4 || box.version !== 1) throw new Error('invalid envelope');
  const point = decodeLoginPart(box.senderKey, 65);
  if (point[0] !== 4) throw new Error('invalid envelope');
  return { ticket: value.ticket, revision, senderKey: box.senderKey, point,
    iv: decodeLoginPart(box.iv, 12), ciphertext: decodeLoginPart(box.ciphertext, 17, 8192) };
}

// Keep the authenticated context aligned with src/worker/rdp-connect-crypto.ts.
async function openConnectLogin(grant) {
  const aad = loginEncoder.encode(JSON.stringify([
    'cloudssh-rdp-login-v1', location.origin, deviceId, grant.revision, grant.transport,
    grant.ticket, grant.clientKey, grant.senderKey,
  ]));
  const sender = await crypto.subtle.importKey('raw', grant.point, loginCurve, false, []);
  const bits = await crypto.subtle.deriveBits({ name: 'ECDH', public: sender }, grant.privateKey, 256);
  let hkdf;
  try { hkdf = await crypto.subtle.importKey('raw', bits, 'HKDF', false, ['deriveKey']); }
  finally { new Uint8Array(bits).fill(0); }
  const aes = await crypto.subtle.deriveKey(
    { name: 'HKDF', hash: 'SHA-256', salt: loginEncoder.encode(grant.ticket), info: aad }, hkdf,
    { name: 'AES-GCM', length: 256 }, false, ['decrypt'],
  );
  const bytes = new Uint8Array(await crypto.subtle.decrypt(
    { name: 'AES-GCM', iv: grant.iv, additionalData: aad, tagLength: 128 }, aes, grant.ciphertext,
  ));
  try {
    const login = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(bytes));
    if (!login || Object.keys(login).length !== 3 || !validLogin(login.username, login.domain, login.password)) {
      throw new Error('invalid login');
    }
    return login;
  } finally { bytes.fill(0); }
}

async function run(preferDirect) {
  let password;
  const abort = new AbortController();
  let stopped = false;
  let ticket;
  let timer;
  let ready = false;
  let activePath, directCarrier, candidateTypes;
  let telemetry, ice, rdp, receiveBytes;
  const channel = [];
  function paintLatency() {
    // Failed preflight attempts never appear as a live route.
    if (!ready || stopped || !activePath) return tellWorkspace('latency', null);
    const now = performance.now();
    const recent = (sample, maxAge) => sample && now - sample.at < maxAge ? sample.ms : null;
    while (channel.length && now - channel[0].at >= 30000) channel.shift();
    tellWorkspace('latency', {
      path: activePath, iceMs: recent(ice, 15000), channelMs: recent(channel.at(-1), 10000),
      channelPeakMs: channel.length ? Math.max(...channel.map(sample => sample.ms)) : null,
      rdpMs: recent(rdp, 30000), receiveBytes: receiveBytes ?? null, candidateTypes,
    });
  }
  function sample() {
    if (!ready || stopped || document.hidden) return;
    const value = window.Module?._cloudssh_take_rdp_rtt?.();
    if (Number.isInteger(value) && value >= 0 && value <= 60000) rdp = { ms: value, at: performance.now() };
    receiveBytes = socket?.takeReceiveBacklog?.();
    paintLatency();
    socket?.probe?.();
    // Browser ICE statistics are independent of the in-band probe. Never await them on the send path.
    void directCarrier?.sampleLink?.();
  }
  function resetMeter() {
    clearInterval(telemetry); telemetry = undefined;
    directCarrier?.resetLink?.();
    socket?.cancelProbe?.();
    void socket?.takeReceiveBacklog?.();
    channel.length = 0;
    ice = rdp = receiveBytes = undefined;
    paintLatency();
  }
  paintLatency();
  function monitorLatency() {
    resetMeter();
    if (!ready || stopped || document.hidden) return;
    sample();
    telemetry = setInterval(sample, 5000);
  }
  document.addEventListener('visibilitychange', () => {
    if (ready && !stopped) window.Module?._cloudssh_take_rdp_rtt?.(); // Discard old background samples.
    monitorLatency();
  }, { signal: abort.signal });
  let negotiatedResize = false;
  let initialSize = viewportSize();
  let resizeTimer, lastSize = '', settledResize;
  function layout(force = false) {
    if (stopped) return;
    let [w, h] = viewportSize();
    if (!negotiatedResize) {
      const factor = Math.min(w / initialSize[0], h / initialSize[1]);
      w = Math.round(initialSize[0] * factor); h = Math.round(initialSize[1] * factor);
    }
    const sizeKey = `${w}x${h}`;
    if (!force && sizeKey === lastSize) return;
    lastSize = sizeKey;
    stage.style.setProperty('--desktop-width', w + 'px');
    stage.style.setProperty('--desktop-height', h + 'px');
    if (negotiatedResize) {
      settledResize = new Event('resize');
      try { window.dispatchEvent(settledResize); } finally { settledResize = undefined; }
    }
  }
  const scheduleLayout = () => { clearTimeout(resizeTimer); resizeTimer = setTimeout(layout, 250); };
  const observer = new ResizeObserver(scheduleLayout);
  observer.observe(stage);
  // This frame is only a FreeRDP runtime. Browsers can emit a burst of window resize events;
  // SDL resizes the backing canvas synchronously on each. Only forward our settled layout.
  window.addEventListener('resize', event => {
    if (event !== settledResize) { event.stopImmediatePropagation(); scheduleLayout(); }
  }, { capture: true, signal: abort.signal });
  layout();
  let pendingFingerprint;
  let decision = -1;
  let acceptedTrust;
  let freerdpError = 0;
  const watch = (ms, reason) => {
    clearTimeout(timer);
    timer = setTimeout(() => finish(reason), ms);
  };
  function finish(reason, keepDialog = false) {
    if (stopped) return;
    stopped = true;
    password = ticket = undefined;
    clearTimeout(timer);
    clearTimeout(resizeTimer);
    observer.disconnect();
    abort.abort();
    resetMeter();
    socket?.close();
    tellWorkspace('ended');
    decision = -1;
    acceptCertificate.disabled = true;
    cancelCertificate.disabled = false;
    if (!keepDialog && certificate.open) certificate.close();
    if (typeof reason === 'number') show(reason);
    else { status.classList.remove('desktop-ready'); status.textContent = reason; }
  }
  function displayCertificate(fingerprint, saved) {
    el('certificate-title').textContent = trust[saved ? 4 : 0];
    el('certificate-help').textContent = trust[saved ? 5 : 1];
    el('certificate-fingerprint').textContent = formatFingerprint(fingerprint);
    el('certificate-saved-box').hidden = !saved;
    el('certificate-saved-label').textContent = trust[6];
    el('certificate-saved').textContent = saved ? formatFingerprint(saved) : '';
    acceptCertificate.textContent = trust[3];
    cancelCertificate.textContent = trust[2];
    acceptCertificate.hidden = !!saved;
    acceptCertificate.disabled = !!saved;
    cancelCertificate.disabled = false;
    if (!certificate.open) certificate.showModal();
  }
  cancelCertificate.onclick = () => {
    if (stopped) return certificate.close();
    finish(trust[9]);
  };
  certificate.oncancel = event => { event.preventDefault(); if (!cancelCertificate.disabled) cancelCertificate.click(); };
  acceptCertificate.onclick = () => {
    if (stopped || !pendingFingerprint || !socket?.lease || acceptCertificate.disabled) return;
    const fingerprint = pendingFingerprint;
    const lease = socket.lease;
    const revision = profile.revision;
    acceptCertificate.disabled = cancelCertificate.disabled = true;
    void (async () => {
      const response = await request(api + '/trust', {
        method: 'PUT', headers: { 'Content-Type': 'application/json', 'X-CloudSSH-RDP-Client': clientRevision },
        signal: AbortSignal.any([abort.signal, AbortSignal.timeout(10_000)]),
        body: JSON.stringify({ fingerprint, revision, lease }),
      });
      if (!response.ok || (await response.json()).fingerprint !== fingerprint) throw new Error('trust rejected');
      if (stopped || pendingFingerprint !== fingerprint || socket.lease !== lease) return;
      acceptedTrust = { revision, fingerprint };
      socket.endCertWait?.();
      if (stopped) return;
      certificate.close();
      if (socket.certHold) {
        // Keep native TLS waiting. Only the relay can confirm this held socket needs a retry.
        show(13);
        watch(5_000, 26);
        return;
      }
      profile.fingerprint = fingerprint;
      decision = 1;
      show(14);
      watch(30_000, 19);
    })().catch(() => finish(trust[7]));
  };
  terminate = finish;
  show(11);
  watch(90_000, 18);
  try {
    const response = await request(base + 'sdl-freerdp.wasm', { cache: 'no-cache', signal: abort.signal });
    if (!response.ok || response.headers.get('Content-Type')?.split(';')[0] !== 'application/wasm') return finish(17);
    let module = await (WebAssembly.compileStreaming ? WebAssembly.compileStreaming(response) : WebAssembly.compile(await response.arrayBuffer()));
    if (stopped) return;
    show(12);
    watch(30_000, 18);
    let url = new URL('/api/rdp/session', location.origin);
    url.protocol = 'wss:';
    async function issue(transport) {
      // No key reuse between a direct attempt, its relay fallback, or a fresh certificate reconnect.
      const keys = await crypto.subtle.generateKey(loginCurve, false, ['deriveBits']);
      const clientKey = loginBase64Url(String.fromCharCode(...new Uint8Array(await crypto.subtle.exportKey('raw', keys.publicKey))));
      if (stopped) return {};
      const response = await request(api + '/connect', {
        method: 'POST', cache: 'no-store', signal: AbortSignal.any([abort.signal, AbortSignal.timeout(8000)]), headers: {
          'X-CloudSSH-RDP-Client': connectRevision, 'X-CloudSSH-RDP-Saved-Revision': String(profile.revision),
          'X-CloudSSH-RDP-Client-Key': clientKey,
