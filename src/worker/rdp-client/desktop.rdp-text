function request(url, options) {
  return fetch(url, { credentials: 'same-origin', redirect: 'error', signal: AbortSignal.timeout(10000), ...options });
}

const loginCurve = { name: 'ECDH', namedCurve: 'P-256' };
const loginEncoder = new TextEncoder();
const loginBase64Url = raw => btoa(raw).replace(/=+$/, '').replace(/\+/g, '-').replace(/\//g, '_');
function decodeLoginPart(value, min, max = min) {
  if (typeof value !== 'string' || value.length < Math.ceil(min * 4 / 3) ||
      value.length > Math.ceil(max * 4 / 3) || !/^[A-Za-z0-9_-]+$/.test(value)) throw new Error('invalid envelope');
  const raw = atob(value.replace(/-/g, '+').replace(/_/g, '/'));
  if (raw.length < min || raw.length > max || loginBase64Url(raw) !== value) throw new Error('invalid envelope');
  return Uint8Array.from(raw, c => c.charCodeAt(0));
}

// Fetch's attempt deadline also bounds reading this body. Never accept legacy plaintext or unbounded JSON.
async function readConnectGrant(response, revision) {
  const bytes = new Uint8Array(12 * 1024);
  const reader = response.body?.getReader();
  if (!reader) throw new Error('missing envelope');
  let size = 0, value;
  try {
    for (;;) {
      const chunk = await reader.read();
      if (chunk.done) break;
      if (size + chunk.value.length > bytes.length) throw new Error('oversized envelope');
      bytes.set(chunk.value, size); size += chunk.value.length;
    }
    value = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(bytes.subarray(0, size)));
  } finally {
    bytes.fill(0);
    void reader.cancel().catch(() => {}); reader.releaseLock();
  }
  const box = value?.loginEnvelope;
  if (!value || Object.keys(value).length !== 3 || value.revision !== revision ||
      typeof value.ticket !== 'string' || !/^[a-f0-9]{64}$/.test(value.ticket) ||
      !box || Object.keys(box).length !== 4 || box.version !== 1) throw new Error('invalid envelope');
  const point = decodeLoginPart(box.senderKey, 65);
  if (point[0] !== 4) throw new Error('invalid envelope');
  return { ticket: value.ticket, revision, senderKey: box.senderKey, point,
    iv: decodeLoginPart(box.iv, 12), ciphertext: decodeLoginPart(box.ciphertext, 17, 8192) };
}

// Keep the authenticated context aligned with src/worker/rdp-connect-crypto.ts.
async function openConnectLogin(grant) {
  const aad = loginEncoder.encode(JSON.stringify([
    'cloudssh-rdp-login-v1', location.origin, deviceId, grant.revision, grant.transport,
    grant.ticket, grant.clientKey, grant.senderKey,
  ]));
  const sender = await crypto.subtle.importKey('raw', grant.point, loginCurve, false, []);
  const bits = await crypto.subtle.deriveBits({ name: 'ECDH', public: sender }, grant.privateKey, 256);
  let hkdf;
  try { hkdf = await crypto.subtle.importKey('raw', bits, 'HKDF', false, ['deriveKey']); }
  finally { new Uint8Array(bits).fill(0); }
  const aes = await crypto.subtle.deriveKey(
    { name: 'HKDF', hash: 'SHA-256', salt: loginEncoder.encode(grant.ticket), info: aad }, hkdf,
    { name: 'AES-GCM', length: 256 }, false, ['decrypt'],
  );
  const bytes = new Uint8Array(await crypto.subtle.decrypt(
    { name: 'AES-GCM', iv: grant.iv, additionalData: aad, tagLength: 128 }, aes, grant.ciphertext,
  ));
  try {
    const login = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(bytes));
    if (!login || Object.keys(login).length !== 3 || !validLogin(login.username, login.domain, login.password)) {
      throw new Error('invalid login');
