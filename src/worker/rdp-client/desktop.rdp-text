// Only these local messages may reach the status line, never an upstream error or close reason.
const failureText = {
  peer_unavailable: ['The Windows connector is not online. Check the Windows service and CloudSSH site.', 'Windows 连接器不在线，请检查 Windows 服务和 CloudSSH 站点。', 'Windows 連接器不在線，請檢查 Windows 服務和 CloudSSH 站點。'],
  peer_timeout: ['The direct connection timed out. Check the connector and UDP network.', '直连超时，请检查连接器和 UDP 网络。', '直連逾時，請檢查連接器和 UDP 網路。'],
  peer_failed: ['Could not connect directly. Check the connector, UDP connectivity and local RDP.', '无法直连，请检查连接器、UDP 网络和本机 RDP。', '無法直連，請檢查連接器、UDP 網路和本機 RDP。'],
