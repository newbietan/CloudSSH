<!doctype html>
<html lang="en-US">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CloudSSH · Remote Desktop</title>
<style>
:root{color-scheme:dark;--bg:#0a0a0a;--text:#eaeaea;--text-muted:#b4b4b4}
*{box-sizing:border-box}[hidden]{display:none!important}
body{display:flex;flex-direction:column;height:100dvh;margin:0;background:var(--bg);color:var(--text);font:14px system-ui}
#status{position:absolute;inset:0 0 auto;z-index:1;margin:0;padding:.25rem .8rem;background:var(--bg);color:var(--text-muted);pointer-events:none}
#status:empty{display:none}#status.desktop-ready{inset:auto;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);padding:0}
.desktop-stage{flex:1;min-height:0;position:relative;display:grid;place-items:center;overflow:hidden;background:#080808}
#canvas{display:block;width:var(--desktop-width,100%)!important;height:var(--desktop-height,100%)!important;max-width:100%;max-height:100%;touch-action:none}
#certificate{--app-modal-width:34rem}
#certificate-help{line-height:1.6}
#certificate-fingerprint,#certificate-saved{display:block;overflow-wrap:anywhere;font:14px/1.5 ui-monospace,monospace;margin-bottom:.55rem}
#certificate .app-modal__actions{margin-top:1rem}
</style>
<style id="cloudssh-modal-css"></style>
<p id="status" role="status" tabindex="-1"></p>
<div class="desktop-stage" id="stage"><canvas id="canvas" tabindex="0"></canvas></div>
<dialog id="certificate" class="app-modal" aria-labelledby="certificate-title" aria-describedby="certificate-help">
  <div class="app-modal__panel app-modal__inset">
    <header class="app-modal__header">
      <h2 id="certificate-title" class="app-modal__title">Windows certificate</h2>
    </header>
    <p id="certificate-help"></p>
    <strong>SHA-256</strong>
    <code id="certificate-fingerprint"></code>
    <div id="certificate-saved-box" hidden>
      <strong id="certificate-saved-label">Previously saved fingerprint</strong>
      <code id="certificate-saved"></code>
    </div>
    <div class="app-modal__actions">
      <button id="certificate-cancel" class="app-modal__button" type="button" autofocus>Cancel</button>
      <button id="certificate-accept" class="app-modal__button app-modal__button--primary" type="button">Trust and connect</button>
    </div>
  </div>
</dialog>
<script data-cfasync="false" src="/rdp/assets/rdp-socket.js" defer></script>
<script data-cfasync="false" src="/rdp/assets/desktop.js" defer></script>
</html>
