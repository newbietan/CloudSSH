<!doctype html>
<html lang="en-US">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CloudSSH · Remote Desktop</title>
<style>
:root{color-scheme:dark;--bg:#0a0a0a;--bg-elevated:#191919;--text:#eaeaea;--text-muted:#b4b4b4;--border:#555;--accent:#93df80}*{box-sizing:border-box}[hidden]{display:none!important}body{display:flex;flex-direction:column;height:100dvh;margin:0;background:var(--bg);color:var(--text);font:14px system-ui}a{color:var(--accent)}h1{font-size:1rem;margin:0}#tools{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;padding:.45rem .8rem;border-bottom:1px solid var(--border);background:var(--bg-elevated)}#tools h1{flex:1 1 8rem}.status-row{display:flex;align-items:center;justify-content:space-between;gap:.25rem .75rem;padding:0 .8rem;flex-wrap:wrap}#latency{color:var(--text-muted);font:12px/1.5 ui-monospace,monospace;font-variant-numeric:tabular-nums;white-space:nowrap}label{display:flex;flex-direction:column;gap:.2rem}button,input{font:inherit;color:var(--text);background:var(--bg);border:1px solid var(--border);border-radius:5px;min-height:40px;padding:.35rem .65rem}button{cursor:pointer;color:var(--accent);align-self:end}button:disabled{opacity:.55;cursor:default}#status{margin:0;padding:.3rem 0;color:var(--text-muted)}.desktop-stage{flex:1;min-height:0;position:relative;display:grid;place-items:center;overflow:hidden;background:#080808}.desktop-stage:fullscreen{width:100vw;height:100dvh}#canvas{display:block;width:var(--desktop-width,100%)!important;height:var(--desktop-height,100%)!important;max-width:100%;max-height:100%;touch-action:none}#stage-label{display:none}.desktop-stage:fullscreen #stage-label{display:block;position:absolute;top:0;left:0;padding:.2rem .6rem;background:var(--bg-elevated);color:var(--text);font-size:11px;pointer-events:none} #certificate{box-sizing:border-box;position:fixed;inset:0;margin:auto;width:min(34rem,calc(100% - 2rem));max-height:calc(100dvh - 2rem);overflow:auto;padding:1.25rem;color:var(--text);background:var(--bg-elevated);border:1px solid var(--border);border-radius:12px}#certificate::backdrop{background:#0009}#certificate-fingerprint,#certificate-saved{display:block;overflow-wrap:anywhere;font:14px/1.5 ui-monospace,monospace;margin-bottom:.55rem}#certificate .actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.5rem;margin-top:1rem}
</style>
<header id="tools"><a href="/" id="back" target="_top">Back to CloudSSH</a>
<h1 id="title">Remote Desktop</h1>
<button id="disconnect" type="button" disabled>Disconnect</button>
<button id="fullscreen" type="button" disabled>Full screen</button></header>
<div class="status-row"><p id="status" role="status" tabindex="-1"></p><span id="latency" hidden></span></div>
<div class="desktop-stage" id="stage"><canvas id="canvas" tabindex="0"></canvas><span id="stage-label">CloudSSH · Windows Server <span id="stage-latency"></span></span></div>
<dialog id="certificate" aria-labelledby="certificate-title" aria-describedby="certificate-help">
  <h2 id="certificate-title">Windows certificate</h2>
  <p id="certificate-help"></p>
  <strong>SHA-256</strong>
  <code id="certificate-fingerprint"></code>
  <div id="certificate-saved-box" hidden>
    <strong id="certificate-saved-label">Previously saved fingerprint</strong>
    <code id="certificate-saved"></code>
  </div>
  <div class="actions">
    <button id="certificate-cancel" type="button" autofocus>Cancel</button>
    <button id="certificate-accept" type="button">Trust and connect</button>
  </div>
</dialog>
<script data-cfasync="false" src="/rdp/assets/rdp-socket.js" defer></script>
<script data-cfasync="false" src="/rdp/assets/desktop.js" defer></script>
</html>
